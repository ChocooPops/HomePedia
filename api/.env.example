# ---------------------------------------------------------------- Application
PORT=8000

# ---------------------------------------------------------------- MariaDB
DB_HOST=localhost
DB_PORT=3310
DB_USER=homepedia
DB_PASSWORD=homepedia
DB_NAME=homepedia
DB_LOGGING=false

# ---------------------------------------------------------------- MongoDB
# Réponses brutes des collectes (raw_payloads) et annonces scrapées (listings)
MONGO_URI=mongodb://homepedia:homepedia@localhost:27017/homepedia?authSource=admin

# ---------------------------------------------------------------- Appels externes
# Timeout par requête (ms) et nombre de nouvelles tentatives (429 / 5xx / réseau)
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=3
# Overpass refuse (HTTP 406) les requêtes sans User-Agent ou avec un contact factice (ex. example.com)
HTTP_USER_AGENT=HomePedia/0.1 (projet etudiant Epitech)
# Archive les réponses brutes dans MongoDB, collection raw_payloads (traçabilité, retraitements)
STORE_RAW_PAYLOADS=true

# ---------------------------------------------------------------- Ingestion des annonces
# Jeton attendu dans l'en-tête X-Ingest-Token de POST /api/listings/ingest (service de scraping).
# Vide : ingestion ouverte, à réserver au développement local.
INGEST_TOKEN=

# ---------------------------------------------------------------- Clés API (facultatives)
# Les sources sans clé sont marquées « skipped » dans fetch_log, sans bloquer les autres.

# Météo-France (portail-api.meteofrance.fr) - réservé, non utilisé dans cette version
METEOFRANCE_API_KEY=
# Atmo France (admindata.atmo-france.org) : compte utilisateur, pas de clé
ATMO_USERNAME=
ATMO_PASSWORD=
# INSEE Sirene 3.11 (portail-api.insee.fr) - en-tête X-INSEE-Api-Key-Integration
INSEE_SIRENE_API_KEY=
# INSEE Melodi : fonctionne sans clé (quota réduit) ; une clé relève le quota
INSEE_API_KEY=
# Annuaire Santé FHIR (gateway.api.esante.gouv.fr) - en-tête ESANTE-API-KEY
ESANTE_API_KEY=
# BDNB : accès libre limité ; une clé relève le quota
BDNB_API_KEY=
# Google Maps Places API (avis des lieux) - clé payante, en-tête X-Goog-Api-Key
GOOGLE_MAPS_API_KEY=
