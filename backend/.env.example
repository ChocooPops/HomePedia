# Copiez ce fichier en .env pour surcharger les valeurs par défaut de docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=homepedia
POSTGRES_DB=homepedia
# Port exposé sur la machine hôte (5432 est souvent déjà pris par un PostgreSQL local).
POSTGRES_HOST_PORT=5434

# --- MongoDB ---
MONGO_USER=homepedia
MONGO_PASSWORD=homepedia
MONGO_DB=homepedia
MONGO_HOST_PORT=27017

# --- API ---
API_HOST_PORT=8000
